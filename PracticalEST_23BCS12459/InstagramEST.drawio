        <mxCell id="TqO54Z6zpZ8KSNMWt7e1-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="- User should be able to create or log in to their account&lt;div&gt;- User should be able to&amp;nbsp; like or comment on other post&lt;/div&gt;&lt;div&gt;- User should be able to&amp;nbsp; view their feed&lt;/div&gt;&lt;div&gt;- User should be able to&amp;nbsp; follow others&lt;/div&gt;&lt;div&gt;- User should be able to&amp;nbsp; create post&lt;/div&gt;" vertex="1">
